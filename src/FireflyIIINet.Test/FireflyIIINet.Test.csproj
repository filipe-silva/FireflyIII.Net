<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FireflyIIINet.Test</AssemblyName>
    <RootNamespace>FireflyIIINet.Test</RootNamespace>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- xunit.v3 test projects are executables (in-process runner) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireflyIIINet\FireflyIIINet.csproj" />
  </ItemGroup>
</Project>

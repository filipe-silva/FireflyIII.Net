<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FireflyIIINet</AssemblyName>
    <PackageId>FireflyIIINet</PackageId>
    <OutputType>Library</OutputType>
    <Authors>FireflyIII.Net</Authors>
    <Company>FireflyIII.Net</Company>
    <AssemblyTitle>Firefly III API Client</AssemblyTitle>
    <Description>A .NET client library for the Firefly III API.</Description>
    <RootNamespace>FireflyIIINet</RootNamespace>
    <!-- Version tracks the Firefly III API version (Major.Minor.Patch);
         the 4th revision component is bumped for client-only changes against the same API version. -->
    <Version>6.7.2.1</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\FireflyIIINet.xml</DocumentationFile>
    <!-- CS1591: undocumented members (Refit interfaces); CS8073: value-type != null in generated Equals -->
    <NoWarn>$(NoWarn);CS1591;CS8073</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/filipe-silva/FireflyIII.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipe-silva/FireflyIII.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>6.7.2.1, client-only changes against Firefly III API 6.7.2. Charts now deserialize: ChartDataSet.Entries/PcEntries and ChartDataSetV2.Entries/NativeEntries read the object the server sends (label to value, numbers or numeric strings, [] when empty) through ChartEntriesConverter, and ChartDataPoint/ChartDataPointV2 gained Value; before, every /v1/chart call threw. Nullable annotations: optional Refit parameters and optional model constructor parameters are nullable, and optional model properties accept null ([AllowNull]), so a nullable-enabled consumer can leave a field unset without CS8601/CS8604/CS8625. Getters keep their declared types. Required-but-nullable fields accept null instead of throwing ArgumentNullException, and send it: PiggyBankStore/PiggyBankProperties.TargetAmount (no target), RecurrenceStore.RepeatUntil (no end), RuleAction/RuleActionStore.Value, PiggyBankAccountStore.Id, TransactionSplit.SourceId/DestinationId.</PackageReleaseNotes>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the repo README as the package readme (referenced by PackageReadmeFile above).
         Path is relative to this project (repo root is two levels up). -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Refit" />
    <!-- Since Refit 14 the reflection request builder is a separate package; referenced here so
         RestService.For<T> works everywhere (on net48 the source-generated stubs are not resolved,
         so reflection is the only path). Keep version-locked to Refit. -->
    <PackageReference Include="Refit.Reflection" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

</Project>
